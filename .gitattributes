#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf


# Release metadata is generated per repo. Keep Piko Plus's copy when merging upstream
# (the sync workflow sets merge.ours.driver=true).
/patches-bundle.json  merge=ours
/patches-list.json    merge=ours
